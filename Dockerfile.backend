FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

# requirements.lock pins every transitive dependency so rebuilds are reproducible;
# regenerate it with uv pip compile (see README) after editing requirements.txt.
COPY requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock

COPY . .

EXPOSE 8000

CMD ["uvicorn", "video_agent_workflow:fastapi_app", "--host", "0.0.0.0", "--port", "8000"]
