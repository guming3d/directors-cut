# Deploy scripts pass a copy mirrored into the project registry (deploy_lib.sh).
ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE} AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

# requirements.lock pins every transitive dependency so rebuilds are reproducible;
# regenerate it with uv pip compile (see docs/getting-started.md) after editing requirements.txt.
COPY requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock

# Copy only what the backend reads at runtime, so local media and notes stay out of the image.
COPY backend ./backend
COPY prompts ./prompts
COPY Chapters/*.txt ./Chapters/
COPY video_agent_workflow.py ./

EXPOSE 8000

CMD ["uvicorn", "video_agent_workflow:fastapi_app", "--host", "0.0.0.0", "--port", "8000"]
