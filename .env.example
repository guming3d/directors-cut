# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_RESPONSES_DEPLOYMENT_NAME=gpt-4o-resp
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Reasoning model for storyboard refinement, scene splitting, first-frame
# prompts, character extraction, and segment descriptions.
AZURE_OPENAI_REASONING_DEPLOYMENT=gpt-6.1-sol
AZURE_OPENAI_REASONING_EFFORT=medium
# Set when gpt-6.1-sol lives on a different resource than Sora (both are then
# required). A Foundry ".../openai/v1" endpoint uses the OpenAI v1 client.
# AZURE_OPENAI_REASONING_ENDPOINT=https://testaistudio0307049060.services.ai.azure.com/openai/v1
# AZURE_OPENAI_REASONING_API_KEY=
# Extra output tokens reserved for reasoning on every call.
# AZURE_OPENAI_REASONING_TOKEN_HEADROOM=8000

# Image generation (Microsoft Foundry GPT Image 2.5)
FOUNDRY_GPT_IMAGE_ENDPOINT=https://testaistudio0307049060.services.ai.azure.com/openai/v1
FOUNDRY_GPT_IMAGE_DEPLOYMENT=gpt-image-2.5-sunburst
FOUNDRY_GPT_IMAGE_API_KEY=

# Legacy names required by sora-openai-client.py
ENDPOINT_URL=https://your-resource.openai.azure.com/
DEPLOYMENT_NAME=sora-2

# Video backend selection (sora2, kling, jimeng, or seedance)
VIDEO_PROVIDER=sora2

# Seedance 2.5 via Volcengine Ark (required when VIDEO_PROVIDER=seedance).
# Billed per generated second: prefer 4-second scenes while testing.
ARK_API_KEY=
SEEDANCE_MODEL=doubao-seedance-2-5-260628
SEEDANCE_GENERATE_AUDIO=true
SEEDANCE_WATERMARK=false
# Optional output resolution (e.g. 720p); omitted from requests when empty.
SEEDANCE_RESOLUTION=
# first_frame pins the opening frame; reference_image only conditions the look.
SEEDANCE_IMAGE_ROLE=first_frame
SEEDANCE_POLL_INTERVAL=10
SEEDANCE_POLL_TIMEOUT=1200

# Cloudflare R2 public bucket for Seedance reference images (Ark needs URLs).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_PREFIX=seedance-refs

# Kling API configuration (required when VIDEO_PROVIDER=kling)
KLING_API_BASE_URL=https://api-beijing.klingai.com
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Optional legacy fallback: directly provide a short-lived token.
# KLING_API_KEY=
KLING_TOKEN_TTL=1800
KLING_MODEL_NAME=kling-v3
KLING_MODE=std
KLING_CFG_SCALE=0.5
KLING_POLL_INTERVAL=3
KLING_POLL_TIMEOUT=600
KLING_DOWNLOAD_CHUNK_SIZE=1048576
KLING_CREATE_MAX_RETRIES=5
KLING_CREATE_RETRY_BASE_DELAY=2
KLING_CREATE_RETRY_MAX_DELAY=30
KLING_CREATE_RETRY_JITTER=0.5

# Jimeng (Volcengine) API configuration
JIMENG_API_BASE_URL=https://visual.volcengineapi.com
JIMENG_ACCESS_KEY_ID=
JIMENG_SECRET_ACCESS_KEY=
# Optional temporary credentials:
# JIMENG_SECURITY_TOKEN=
JIMENG_REGION=cn-north-1
JIMENG_SERVICE=cv
JIMENG_POLL_INTERVAL=3
JIMENG_POLL_TIMEOUT=900

# Optional: OpenAI API Key (alternative)
# OPENAI_API_KEY=your_openai_key_here

# Azure Container Apps Deployment
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=sora-workflow-rg
AZURE_CONTAINER_REGISTRY=soraworkflowacr
AZURE_CONTAINERAPPS_ENVIRONMENT=sora-workflow-env
AZURE_CONTAINERAPPS_BACKEND=sora-workflow-backend
AZURE_CONTAINERAPPS_FRONTEND=sora-workflow-frontend
SORA_WORKFLOW_ALLOWED_ORIGINS=https://sora-workflow-frontend.hash.eastus.azurecontainerapps.io
FRONTEND_API_BASE_URL=https://sora-workflow-backend.hash.eastus.azurecontainerapps.io

# Backend API authentication + request hardening
SORA_WORKFLOW_REQUIRE_AUTH=1
SORA_WORKFLOW_USERNAME=admin
SORA_WORKFLOW_PASSWORD=
# Optional token auth (Bearer or x-api-key). Leave empty if using Basic auth above.
SORA_WORKFLOW_API_TOKEN=
JSON_IMAGE_MAX_UPLOAD_MB=20
SUBPROCESS_TIMEOUT_SECONDS=1800

# Azure Content Understanding
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=https://your-speech-resource.cognitiveservices.azure.com/
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://your-content-understanding-resource.cognitiveservices.azure.com/
AZURE_CONTENT_UNDERSTANDING_API_VERSION=2025-05-01-preview
AZURE_CONTENT_UNDERSTANDING_API_KEY=
AZURE_CONTENT_UNDERSTANDING_ANALYZER_ID=prebuilt-videoAnalyzer
CONTENT_UNDERSTANDING_MAX_UPLOAD_MB=200
CONTENT_UNDERSTANDING_POLL_INTERVAL=2
CONTENT_UNDERSTANDING_POLL_TIMEOUT=600

# Video reproduce workflow
REPRODUCE_SEGMENTATION_BACKEND=content_understanding
REPRODUCE_THREADS=3
REPRODUCE_SEGMENT_FRAME_SAMPLES=5
REPRODUCE_REFERENCE_MODE=start_end
